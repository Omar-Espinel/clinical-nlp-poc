# Copy this file to .env and fill in your values
# Never commit .env to version control

# Required when pgvector_cascade is active (now the default; auto-falls back to
# hybrid_cascade if this URL is unreachable). Use localhost when running the
# Postgres+pgvector instance directly on the host; use 'db' (or your compose
# service name) when running inside the siteid-app docker network.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clinical_nlp

# Optional — explicit strategy override. Respected verbatim; disables the
# DB-reachability auto-fallback. Leave unset in normal use.
# SNOMED_SEARCH_STRATEGY=pgvector_cascade

# Optional — BioPortal fallback API key (https://bioportal.bioontology.org/account)
BIOPORTAL_API_KEY=

# Optional — Internal API key for FastAPI auth (existing)
API_KEY=

# Optional — CORS origins (existing)
ALLOWED_ORIGINS=http://localhost:3000