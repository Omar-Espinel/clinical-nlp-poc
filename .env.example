# Copy this file to .env and fill in your values
# Never commit .env to version control

# Required: Get a free key at https://console.groq.com
GROQ_API_KEY=YOUR_KEY

# Required for pgvector_cascade strategy
DATABASE_URL=postgresql://postgres:postgres@db:5432/siteid

# Optional — BioPortal fallback API key (https://bioportal.bioontology.org/account)
BIOPORTAL_API_KEY=

# Optional — Internal API key for FastAPI auth (existing)
API_KEY=

# Optional — CORS origins (existing)
ALLOWED_ORIGINS=http://localhost:3000